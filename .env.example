# ChatHub Environment Configuration
# Copy this file to .env and fill in your values

# JWT Configuration
# Algorithm: HS256 (symmetric) or RS256 (RSA with public key)
JWT__SigningKey=your-256-bit-secret-key-here-change-in-production
JWT__Issuer=ChatHub
JWT__Audience=ChatHub
JWT__ValidateAudience=false
JWT__Algorithm=HS256
# For RS256, provide the PEM public key (without headers, base64, or full PEM)
JWT__PublicKey=

# MongoDB
MONGO_CONNECTION_STRING=mongodb://localhost:27017/chathub
MONGO_DATABASE_NAME=chathub

# Redis
REDIS_CONNECTION_STRING=localhost:6379

# NATS
NATS_URL=nats://localhost:4222
NATS_QUEUE_GROUP=chathub-hub

# S3/MinIO Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=chathub-uploads
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ChatHub Settings
CHATHUB_MAX_MESSAGE_SIZE_BYTES=65536
CHATHUB_PING_INTERVAL_SECONDS=15
CHATHUB_IDLE_TIMEOUT_MINUTES=30
CHATHUB_RATE_LIMIT_TEXT_PER_MINUTE=100
CHATHUB_RATE_LIMIT_VOICE_PER_MINUTE=10
CHATHUB_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Pod Configuration (for Kubernetes)
POD_ID=local-dev
