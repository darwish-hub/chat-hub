{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "ChatHub": {
    "MaxMessageSizeBytes": 65536,
    "AllowedOrigins": ["*"],
    "PingIntervalSeconds": 15,
    "PongTimeoutSeconds": 10,
    "IdleTimeoutMinutes": 30,
    "RateLimitTextPerMinute": 1000,
    "RateLimitVoicePerMinute": 100,
    "PodId": "dev"
  }
}
